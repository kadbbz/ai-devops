{
  "name": "ai-native-devops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "start": "node dist/server.js",
    "test:api": "NODE_ENV=test tsx --test doc/test_case/api/*.test.ts",
    "test:e2e": "playwright test --config doc/test_case/playwright.config.ts",
    "test": "npm run build && npm run test:api && npm run test:e2e && npm run test:integration && npm run test:ops",
    "test:integration": "tsx doc/test_case/integration.ts",
    "format": "prettier --write src web/src doc/test_case/*.ts doc/test_case/api/*.ts doc/test_case/e2e/*.ts",
    "test:ops": "tsx doc/test_case/ops-integration.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.0.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.5",
    "antd": "5.27.4",
    "fastify": "5.12.5",
    "mysql2": "3.24.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.9.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "bin": {
    "devops": "cli/devops.mjs"
  }
}
