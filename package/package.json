{
  "name": "ai-devops-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development STATE_FILE=.data/state.json tsx watch src/server.ts",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node dist/server.js",
    "test:api": "NODE_ENV=test node --import tsx/esm --test ../test/api.test.ts",
    "test:e2e": "NODE_PATH=./node_modules playwright test ../test/e2e --config=../test/playwright.config.ts",
    "test": "npm run build && npm run test:api",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@tanstack/react-query": "^5.104.1",
    "antd": "^5.27.4",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.0",
    "mysql2": "^3.24.5",
    "node-sql-parser": "^5.4.0",
    "postcss": "^8.5.28",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "vite": "^7.1.7"
  }
}
